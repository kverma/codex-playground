{
  "name": "apple-inspired",
  "displayName": "Apple Inspired",
  "version": "1.0.0",
  "css": [
    "theme.css"
  ],
  "allowedComponents": [
    "title-slide",
    "eyebrow",
    "subtitle",
    "two-column",
    "three-column",
    "card",
    "metric",
    "callout",
    "chart"
  ],
  "width": 1920,
  "height": 1080,
  "rules": {
    "minimumBodyFontPx": 27,
    "minimumCaptionFontPx": 18,
    "minimumMarginPx": 80,
    "maximumColumns": 3,
    "densityPreferredMax": 0.64,
    "densityWarningMax": 0.76,
    "densityMaximum": 0.86,
    "requireTitle": true
  },
  "appearance": "light"
}
