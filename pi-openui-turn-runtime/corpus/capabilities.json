{
  "version": 1,
  "capabilities": {
    "demo.failedBuilds": {
      "permissions": [
        "ci:read"
      ],
      "readOnly": true,
      "args": [
        "repository",
        "branch",
        "hours"
      ],
      "outputs": {
        "count": "string",
        "window": "string",
        "prettyRuns": "string",
        "runs": "array"
      }
    },
    "api.get": {
      "permissions": [
        "api:read"
      ],
      "readOnly": true,
      "args": [
        "endpoint",
        "params"
      ]
    },
    "mcp.invoke": {
      "permissions": [
        "mcp:read"
      ],
      "readOnly": true,
      "args": [
        "tool",
        "input"
      ]
    },
    "appstore.search": {
      "permissions": [
        "appstore:read"
      ],
      "readOnly": true,
      "args": [
        "query",
        "price",
        "limit"
      ],
      "outputs": {
        "query": "string",
        "price": "string",
        "apps": "array",
        "ids": "array",
        "names": "array",
        "total": "number",
        "mock": "boolean",
        "source": "string"
      }
    },
    "appstore.details": {
      "permissions": [
        "appstore:read"
      ],
      "readOnly": true,
      "args": [
        "id"
      ],
      "outputs": {
        "app": "nullable-object",
        "mock": "boolean",
        "source": "string"
      }
    },
    "appstore.compare": {
      "permissions": [
        "appstore:read"
      ],
      "readOnly": true,
      "args": [
        "ids"
      ],
      "outputs": {
        "apps": "array",
        "ids": "array",
        "mock": "boolean",
        "source": "string"
      }
    }
  }
}
